---
import "../styles/global.css";
import "../styles/home.css";

import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Services from "../components/Services.astro";
import KindWords from "../components/KindWords.astro";
import Contact from "../components/Contact.astro";
import Fun from "../components/Fun.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Button from "../components/Button.astro";

const projectModules = import.meta.glob<{
  frontmatter: { title: string };
}>("./projects/*.mdx", { eager: true });

const caseStudies = Object.entries(projectModules).map(([path, mod]) => {
  const slug = path.split("/").pop()?.replace(".mdx", "") ?? "";
  return {
    title: mod.frontmatter.title,
    slug: `/projects/${slug}`,
  };
});

const stats = [
  { label: "Based In", calloutText: "Bellingham, WA" },
  {
    label: "Org Specialties",
    calloutText: "B2B, SaaS, Agency, Small Business",
  },
  { label: "CMS Specialties", calloutText: "Squarespace, Webflow, Headless" },
  { label: "Design Stack", calloutText: "Adobe, Figma, Canva" },
  { label: "Tech Stack", calloutText: "React, HTML, CSS, Astro" },
  { label: "Years Wrangling the Web", calloutText: "10+" },
  { label: "Office Mate", calloutText: "Sleepy", additionalEl: true },
];
---

<BaseLayout pageTitle="CassiGS Marketing Web Engineer & Web Development">
  <Hero />
  <About pageIndex={1} pageTitle="About" listItems={stats}>
    <div class="about__column-text">
      <div>
        <p>
          I've worn a lot of hats in my career. As a designer who has explored
          everything from visual journalism, marketing, and frontend
          development, I approach design with technical precision and an
          editorial and marketing eye. Currently I'm working on:
        </p>

        <p>
          <strong>CGS DesignCo.:</strong> Coming soon - a Shopify and Squarespace
          web shop for small businesses and creative entrepreneurs.
        </p>
        <p>
          <strong
            ><a href="https://studio.cassigs.com/">CassiGS Studio</a>:</strong
          > My illustration studio where I also explore art and creativity.
        </p>
        <p>
          <strong>General freelance design and development work:</strong> I am also
          available for general projects. Reach out to see if I'd be a good fit for
          your project or team!
        </p>
      </div>
      <div class="about__buttons">
        <Button
          link="/CGS_Resume2026.pdf"
          linkText="Download Resume"
          type="download"
        />
        <Button
          link="https://www.linkedin.com/in/cassigs/"
          linkText="Connect on LinkedIn"
          type="external"
        />
      </div>
    </div>
  </About>
  <!-- <Services /> -->
  <CaseStudies caseStudies={caseStudies} />
  <KindWords />
  <div class="home__more-group">
    <Contact />
    <Fun />
  </div>
</BaseLayout>

<style>
  .home__more-group {
    display: grid;
    width: 90%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 0 5rem;
  }
  @media (min-width: 900px) {
    .home__more-group {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }
  .about__buttons {
    display: flex;
    gap: 2rem;
  }

  .about__column-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .about__column-text p {
    margin: 0 0 2rem 0;
  }
</style>
